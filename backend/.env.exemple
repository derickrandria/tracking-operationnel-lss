# ══════════ CONFIGURATION PRODUCTION — renommez ce fichier en « .env » ══════════
# Remplissez vos vraies valeurs puis redémarrez le serveur (demarrer.bat).
#
# STRATÉGIE CALIBRÉE SUR LES PORTAILS RÉELS (31/07/2026 — plateforme v1.7) :
#   ┌─────────────────────────────────────────────────────────────────────┐
#   │ MODE MIXTE (COLLECTOR_SOURCE=MIXTE) — les deux portails à la fois   │
#   │                                                                     │
#   │ NIVEAU 1 · temps réel  : onglet Événements MZoneX (filtre           │
#   │   DEMARRAGE/ARRET, groupe « LSS (LPSA) (37) ») → trajets PROVISOIRE │
#   │   visibles de suite (orange italique)                               │
#   │ NIVEAU 2 · validé      : onglet Trajets MZoneX + rapport « Detail   │
#   │   Trajet groupe de véhicules » CamtrackPro (véhicule par véhicule)  │
#   │   → les trajets clôturés passent en VALIDÉ (remplacement en place,  │
#   │   pas de doublon ; divergence > 10 min signalée au journal d'audit) │
#   │                                                                     │
#   │ CamtrackPro n'a pas de flux temps réel fiable (§5) : ses trajets    │
#   │ arrivent directement en VALIDÉ (~15 min après la clôture).          │
#   └─────────────────────────────────────────────────────────────────────┘
#
# Prérequis scraping :  python -m pip install playwright
#                       python -m playwright install chromium

# --- Bascule simulateur → données réelles (§10)
SIM_ENABLE=0
COLLECTOR_SOURCE=MIXTE             # MIXTE (recommandé) · MZONEX · CAMTRACKPRO
COLLECTOR_PERIODE_S=10             # Niveau 1 API : collecte quasi temps réel

# ═══ Portail MZoneX — https://live.mzoneweb.net/mzonex/
MZONEX_URL=https://live.mzoneweb.net/mzonex/
MZONEX_USER=votre_utilisateur
MZONEX_PASSWORD=votre_mot_de_passe
# Sélecteurs calibrés (SSO Keycloak) — n'éditez que si le portail change :
MZONEX_SEL_USER=#login-input-username
MZONEX_SEL_PASS=#login-input-password
MZONEX_SEL_SUBMIT=#login-button
# Onglet Événements : filtre groupe véhicules « LSS (LPSA) (37) »,
# Event Type Group « DEMARRAGE/ARRET (2) » — pagination Wijmo (flèche « > »).
MZONEX_ONGLET_EVENEMENTS=événements
MZONEX_GROUPE=LSS (LPSA)
MZONEX_EVT_PAGES=12                # pages max lues (Événements ; ~7 réelles)
MZONEX_TRA_PAGES=12                # pages max lues (Trajets)
# Sélecteurs de secours si le portail évolue : MZONEX_SEL_ONGLET_*,
# MZONEX_COMBO_*, MZONEX_SEL_PAGE_SUIVANTE, MZONEX_EVT_COL_*, MZONEX_TRA_COL_*

# ═══ Portail CamtrackPro — https://hosting.camtrack.net
CAMTRACKPRO_URL=https://hosting.camtrack.net/?lang=fr
CAMTRACKPRO_USER=votre_utilisateur
CAMTRACKPRO_PASSWORD=votre_mot_de_passe
# Rapport (Niveau 2) — sélecteurs calibrés sur le portail réel :
CTPRO_MODELE_TRAJETS=Detail Trajet groupe de véhicules
CTPRO_ATTENTE_RAPPORT_S=11         # délai max d'attente d'un rapport
CAMTRACKPRO_PAUSE_VEHICULE_S=2     # pause entre deux véhicules
# La liste des véhicules CamtrackPro = cartes « Véhicules » plateforme
# CAMTRACKPRO (fragment tapé = chiffres de tête de la plaque « 0826TBS » →
# « 0826 ») ; surcharge complète possible :
# CAMTRACKPRO_FRAGMENTS=0826,0906,3076,4296,5346,5506,5616,5626,5646,5716,6546,7306,9176

# --- Réconciliation (Niveau 2) : fréquence et tolérances = Paramètres de
#     l'application (FREQUENCE_SYNC_TRAJETS_VALIDES 15 min par défaut,
#     SEUIL_TOLERANCE_RAPPROCHEMENT_TRAJET 2 min, SEUIL_DIVERGENCE_TRAJET 10 min).

# --- Sécurité (production)
# JWT_SECRET=changez-moi-absolument

# §0sexies A4 (arbitrage 20/08/2026) — API Wialon (CamtrackPro)
# Jeton créé par l'exploitant dans le formulaire oAuth du portail :
#   https://hosting.camtrack.net/login.html?client_id=LSS-Plateforme&access_type=-1&activation_time=0&duration=0&lang=fr
# (après connexion, copier la valeur access_token= de la barre d'adresse).
# Laisser vide = collecteur CamtrackPro écran seul (comportement ≤ v1.25).
CAMTRACKPRO_TOKEN=
CAMTRACKPRO_API_ENABLE=1
# Réglages fins (normalement inutile d'y toucher) :
# WIALON_API_URL=https://hst-api.wialon.com/wialon/ajax.html
# CAMTRACKPRO_API_RAPPORT_NOM=Detail Trajet Vehicule

# §0septies (arbitrage 20/08/2026) — conducteurs & conduite
# Clés de service écartées de l'attribution automatique (insensible
# casse/accents, séparées par des virgules) : pour ces badges, la saisie
# manuelle du chauffeur fait le travail.
# CONDUCTEUR_BADGE_IGNORES=nouveau conducteur,garage lss
# Rechargement des géozones des portails (alerte vitesse hors zone) : 6 h.
# GEOZONES_PERIODE_CACHE_S=21600

# §0quinquies decies I5 (arbitrage 25/08, exécution 26/08/2026) — collecteur
# Ym@ne (infractions). ACTIVÉ v1.36 : branchement GRAVÉ après vérification en
# direct avec le compte LSS (session applicative POST /login/ → JSESSIONID,
# rapport GET /detailedexceptionreport, fenêtre J-1→J par cycle, filtre
# « enregistrement » souverain à l'import). Mettre 0 pour couper le flux.
YMANE_ACTIVE=1
YMANE_URL=https://bi.camtrack.pro
# Identifiants : identiques à MZoneX par défaut (consigne exploitant 25/08) ;
# sinon décommenter et renseigner :
# YMANE_USER=
# YMANE_PASSWORD=
# Branchement gravé (I5, 26/08/2026) — ne pas modifier hors arbitrage :
# YMANE_LOGIN_PATH=/login/
# YMANE_LISTE_PATH=/detailedexceptionreport
# YMANE_LANGUE=French
# Surcharges possibles (sinon lus dans la réponse de connexion) :
# YMANE_CLIENT_ID= / YMANE_AFFILIATE_ID= / YMANE_TRANSPORTER_ID=2004

# §0nonies decies M1/M3 (arbitrage 29/08/2026) — rattrapage des boîtiers muets.
# Relecture des trajets officiels : à chaque cycle, aujourd'hui + hier ;
# passe profonde J-7 → J au démarrage puis toutes les heures. Valeurs
# recommandées gravées — ne modifier qu'après arbitrage.
# RELECTURE_TRAJETS_JOURS=7
# RELECTURE_PROFONDE_PERIODE_S=3600
# PROFONDEUR historique relue par l'appel incrémental Événements MZoneX
# (3 heures) — un boîtier muet qui renvoie son tampon avec moins de 3 h de
# retard est rattrapé en direct. NE PAS confondre avec la tranche ci-dessous.
# MZONEX_API_FENETRE_MAX_S=10800
# TAILLE D'UNE TRANCHE de requête OData (15 minutes) : garde les réponses
# légères et rapides. Une fenêtre de 3 h = 12 tranches. Régler ce paramètre
# ne change JAMAIS la profondeur relue.
# MZONEX_API_TRANCHE_S=900

# ── Correctifs v1.46 (04/09/2026 — camions avec données manquantes) ──────────
# Session Wialon partagée (v1.46, abroge l'arbitrage O4 du 01/09/2026) :
# UNE session unique par le processus — plus d'invalidation de session à
# chaque cycle, portail web CamtrackPro redevient utilisable sur le serveur.
WIALON_SESSION_PARTAGEE=1
# Relecture N1 : rejoue les Événements MZoneX des 7 derniers jours (au
# démarrage puis chaque heure) pour rattraper les trous > 3 h d'une panne de
# collecte. Idempotent (anti-rejeu).
# RELECTURE_N1_ACTIVE=1
# RELECTURE_N1_JOURS=7
# RELECTURE_N1_PERIODE_S=3600
# Alerte « Collecte GPS en retard » (défaut 15 min, fenêtre 05h–22h) :
# SEUIL_RETARD_COLLECTE_S=900
# Plafond de pagination MZoneX (un WARNING est émis si atteint) :
# MZONEX_API_MAX_PAGES=10
# MZONEX_API_TAILLE_PAGE=900
